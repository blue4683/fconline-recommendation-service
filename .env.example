# 실제 값은 .env에만 입력한다. 비밀번호 기본값은 제공하지 않는다.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=frs
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=
MONGO_EXPRESS_PASSWORD=
# 호스트 실행은 로컬 번들 경로, Compose는 /models/실행ID/bundle을 사용한다.
# 모델 경로와 매니페스트의 model_version을 함께 명시한다. 빈 값은 미설정이다.
API_PORT=8000
API_MODEL_DIR=
API_MODEL_VERSION=

# 별도 합성 Agent 앱(127.0.0.1:8001). 세 값을 명시하며 원래 관측 시각을 자동 갱신하지 않는다.
# 시작 시 모델 상태 확인2회가 있으므로 실제 실행은 승인 범위를 확인한다.
# 관측 모드: observed이면 AGENT_RUN_ID에 real-data-... 실행 ID를 쓰고 AGENT_OBSERVED_AT은 비운다.
AGENT_DATA_MODE=
# 관측 공급기: 빈 값/file은 기존 파일, mongodb는 원본 파일과 대조한 로컬 DB만 사용한다.
# synthetic 모드에서 mongodb는 거부한다. DB 장애/불일치 시 파일 대체/자동 적재 없음.
AGENT_MATERIAL_SOURCE=
AGENT_RUN_ID=
AGENT_OBSERVED_AT=
AGENT_MODEL_DIGEST=
# web-agent.v2 다요소 방식(관측 모드 전용). 정책 파일 경로와 기대 해시를 둘 다 명시해야 켜진다.
# 예: docs/examples/multi-factor-core-policy.json. 자동 선택·최신 파일 탐색 없음.
AGENT_SCORING_POLICY_PATH=
AGENT_SCORING_POLICY_VERSION=

# 별도 문서 Q&A. 기본 비활성. 실제 시작은 상태2회·질의당 추론최대1회가 있다.
RAG_ENABLED=0
RAG_MODEL_DIGEST=
# 키 존재만으로 전송하지 않는다. --upload-trace/--upload-traces를 따로 명시한다.
# 계정 리전에 맞춰 https://api.smith.langchain.com 또는 https://eu.api.smith.langchain.com 선택.
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=
