{
  "name": "frs-web",
  "private": true,
  "version": "0.1.0",
  "description": "FRS 합성·관측 자료 스쿼드 웹 클라이언트 (합성·관측 web-agent.v1)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
